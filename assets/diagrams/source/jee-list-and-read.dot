digraph G {
  graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.45", splines=polyline];
  node [shape=box, style="rounded,filled", fillcolor="#10213b", color="#445b79", fontcolor="#e1e8fa", fontname="DejaVu Sans", fontsize=17, margin="0.18,0.14", penwidth=1.1];
  edge [color="#64ffda", fontcolor="#bdcbe4", fontname="DejaVu Sans", fontsize=14, arrowsize=0.7, penwidth=1.3];
  list_request [label="LIST request\nAsk which objects exist"];
  names [label="Response: object names\nThe index, not the file contents"];
  read_request [label="GET request\nAsk for one named object"];
  contents [label="Response: file contents\nA result record or admit-card file", color="#64ffda"];
  list_request -> names;
  names -> read_request [label="Use a returned name"];
  read_request -> contents;
}
