digraph G {
  graph [rankdir=TB, bgcolor="transparent", pad="0.22", nodesep="0.55", ranksep="0.65", splines=polyline];
  node [shape=box, style="rounded,filled", fillcolor="#10213b", color="#445b79", fontcolor="#e1e8fa", fontname="DejaVu Sans", fontsize=17, margin="0.20,0.14", penwidth=1.1];
  edge [color="#64ffda", fontcolor="#bdcbe4", fontname="DejaVu Sans", fontsize=14, arrowsize=0.7, penwidth=1.3];
  bucket [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>Bucket</B></TD></TR><TR><TD><FONT POINT-SIZE="15">A named container for files</FONT></TD></TR></TABLE>>, shape=cylinder];
  prefix [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>Prefix: results/</B></TD></TR><TR><TD><FONT POINT-SIZE="15">The beginning of an object name</FONT></TD></TR></TABLE>>];
  object [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>Object:<BR/>results/example.json</B></TD></TR><TR><TD><FONT POINT-SIZE="15">One stored file</FONT></TD></TR></TABLE>>];
  bucket -> prefix [label="  Group matching  \n  names  "];
  prefix -> object [label="  Name identifies  \n  the object  "];
}
