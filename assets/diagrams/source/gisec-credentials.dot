digraph G {
  graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.32", ranksep="0.45", splines=polyline];
  node [shape=box, style="rounded,filled", fillcolor="#10213b", color="#445b79", fontcolor="#e1e8fa", fontname="DejaVu Sans", fontsize=17, margin="0.18,0.14", penwidth=1.1];
  edge [color="#64ffda", fontcolor="#bdcbe4", fontname="DejaVu Sans", fontsize=14, arrowsize=0.7, penwidth=1.3];
  config [label="Configuration file\nConnection string exposed"];
  address [label="Server + database\nWhere to connect"];
  login [label="Username + password\nWhich identity to use"];
  query [label="Successful login\nA SELECT query asks for rows"];
  rows [label="Query results\nReal visitor and payment data", color="#64ffda"];
  config -> address;
  address -> login [label="The same connection string"];
  login -> query [label="Credentials accepted"];
  query -> rows [label="Read permission exercised"];
}
