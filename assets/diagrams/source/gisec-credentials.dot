digraph G {
  graph [rankdir=TB, bgcolor="transparent", pad="0.22", nodesep="0.55", ranksep="0.65", splines=polyline];
  node [shape=box, style="rounded,filled", fillcolor="#10213b", color="#445b79", fontcolor="#e1e8fa", fontname="DejaVu Sans", fontsize=17, margin="0.20,0.14", penwidth=1.1];
  edge [color="#64ffda", fontcolor="#bdcbe4", fontname="DejaVu Sans", fontsize=14, arrowsize=0.7, penwidth=1.3];
  config [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>Configuration file</B></TD></TR><TR><TD><FONT POINT-SIZE="15">Connection string exposed</FONT></TD></TR></TABLE>>];
  address [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>Server + database</B></TD></TR><TR><TD><FONT POINT-SIZE="15">Where to connect</FONT></TD></TR></TABLE>>];
  login [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>Username + password</B></TD></TR><TR><TD><FONT POINT-SIZE="15">Which identity to use</FONT></TD></TR></TABLE>>];
  query [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>Successful login</B></TD></TR><TR><TD><FONT POINT-SIZE="15">A SELECT query asks for rows</FONT></TD></TR></TABLE>>];
  rows [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>Query results</B></TD></TR><TR><TD><FONT POINT-SIZE="15">Real visitor and payment data</FONT></TD></TR></TABLE>>, color="#64ffda"];
  config -> address;
  address -> login [label="  The same connection  \n  string  "];
  login -> query [label="  Credentials accepted  "];
  query -> rows [label="  Read permission  \n  exercised  "];
}
