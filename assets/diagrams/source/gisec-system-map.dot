digraph G {
  graph [rankdir=TB, bgcolor="transparent", pad="0.22", nodesep="0.55", ranksep="0.65", splines=polyline];
  node [shape=box, style="rounded,filled", fillcolor="#10213b", color="#445b79", fontcolor="#e1e8fa", fontname="DejaVu Sans", fontsize=17, margin="0.20,0.14", penwidth=1.1];
  edge [color="#64ffda", fontcolor="#bdcbe4", fontname="DejaVu Sans", fontsize=14, arrowsize=0.7, penwidth=1.3];
  browser [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>My browser</B></TD></TR><TR><TD><FONT POINT-SIZE="15">No registration login</FONT></TD></TR></TABLE>>];
  api [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>Registration API</B></TD></TR><TR><TD><FONT POINT-SIZE="15">Receives a file request</FONT></TD></TR></TABLE>>];
  files [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>Server files</B></TD></TR><TR><TD><FONT POINT-SIZE="15">web.config returned</FONT></TD></TR></TABLE>>];
  client [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>My SQL client</B></TD></TR><TR><TD><FONT POINT-SIZE="15">Uses the exposed credentials</FONT></TD></TR></TABLE>>];
  db [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>SQL Server</B></TD></TR><TR><TD><FONT POINT-SIZE="15">Stores visitor and payment rows</FONT></TD></TR></TABLE>>, shape=cylinder];
  browser -> api [label="  HTTP request  "];
  api -> files [label="  File read  "];
  files -> client [label="  Returns credentials  "];
  client -> db [label="  Separate SQL login  "];
}
